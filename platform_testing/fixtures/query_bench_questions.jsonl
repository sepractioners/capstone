{"id": "q1_by_status", "question": "How many contracts do we have, by lifecycle status?", "class": "count-by-status", "expect_all": ["24", "15"], "expect_regex": "\\b1\\b.*review|review.*\\b1\\b|1 in review", "expect_plan": [{"tool": "count_contracts"}]}
{"id": "q2_filtered_count", "question": "How many active vendor agreements do we have?", "class": "filtered-count", "expect_regex": "(^|[^0-9])2([^0-9]|$)", "reject_regex": "(24|40)\\s*(active\\s+)?(vendor|contract)", "expect_plan": [{"tool": "count_contracts"}]}
{"id": "q3_list", "question": "List all co-branding agreements", "class": "list", "expect_regex": "(^|[^0-9])4\\s+(contract|co-?branding)", "expect_plan": [{"tool": "list_contracts"}]}
{"id": "q4_breakdown", "question": "Break down contracts by type", "class": "breakdown", "expect_all": ["7", "distribution"], "expect_regex": "nda\\D*1\\b", "expect_plan": [{"tool": "count_contracts"}]}
{"id": "q5_enumerate", "question": "Which contracts mention liability insurance?", "class": "enumerate-by-phrase", "expect_regex": "(^|[^0-9])15([^0-9]|$)", "expect_plan": [{"tool": "find_contracts"}]}
{"id": "q6_clause_synthesis", "question": "What payment obligations do we have across all contracts?", "class": "clause-synthesis", "expect_regex": "pay|invoic|obligation", "min_len": 80, "expect_plan": [{"tool": "find_contracts"}, {"tool": "search_clauses"}]}
{"id": "q14_portfolio_risk_summary", "question": "What are the most significant contractual risks across our portfolio?", "class": "risk-exposure", "expect_regex": "risk|liabilit|indemnif|terminat|exposure|auto[- ]?renew", "min_len": 200, "expect_plan": [{"tool": "find_contracts"}, {"tool": "search_clauses"}]}
