# ---------------------------------------------------------------------------
# Workspace LLM configuration - the single source of truth for every agent.
# Copy to .env (gitignored) and edit. Loaded by agent_llm; extraction, review,
# query, planner, summary, and the platform evaluator all read these values.
# ---------------------------------------------------------------------------

# Base provider/model for every agent LLM call (per-role overrides below).
# provider is any any-llm provider: ollama, anthropic, openai, openrouter, groq, ...
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:latest
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=300

# Retry transient provider errors (rate limits, 5xx) - useful on shared/free pools.
# LLM_RETRIES=2
# LLM_RETRY_BACKOFF_SECONDS=3

# Remote / LAN Ollama host. Sets the chat api_base AND, unless EMBEDDING_URL is
# given, the embedding endpoint (${OLLAMA_HOST}/api/embed).
# OLLAMA_HOST=http://192.168.1.172:11434

# OpenRouter example (chat only; embeddings still need a local/Ollama endpoint):
# LLM_PROVIDER=openrouter
# LLM_MODEL=google/gemma-3-27b-it
# OPENROUTER_API_KEY=sk-or-v1-...

# Local embeddings (default: ${OLLAMA_HOST}/api/embed, else localhost:11434).
# EMBEDDING_MODEL=nomic-embed-text:latest
# EMBEDDING_URL=http://127.0.0.1:11434/api/embed

# Per-role overrides. Each falls back to LLM_* then a built-in default. Roles:
#   EXTRACTION_LLM_*  REVIEW_LLM_*  QUERY_LLM_*  PLANNER_LLM_*  SUMMARY_LLM_*  PLATFORM_LLM_*
# e.g. Claude for extraction + review, local model for everything else:
# EXTRACTION_LLM_PROVIDER=anthropic
# EXTRACTION_LLM_MODEL=claude-haiku-4-5-20251001
# REVIEW_LLM_PROVIDER=anthropic
# REVIEW_LLM_MODEL=claude-haiku-4-5-20251001
# A per-role API base is also honoured: <ROLE>_LLM_API_BASE / LLM_API_BASE.

# Provider credentials (any-llm reads these directly).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Database Configuration - Single source of truth for all databases
# ---------------------------------------------------------------------------
# Main domain database (contracts, obligations, users, organizations)
CLM_DATABASE_PATH=./clm.sqlite3

# RAG knowledge index (embeddings for extraction agent)
EXTRACTION_RAG_DB=synthetic_data_loader/rag_knowledge.sqlite3

# ---------------------------------------------------------------------------
# Behavioural knobs (not provider details - kept per component; optional)
# ---------------------------------------------------------------------------
# EXTRACTION_REVIEW_ENABLED=1
# EXTRACTION_RAG_ENABLED=1
# EXTRACTION_LLM_MAX_ATTEMPTS=3
# QUERY_PLAN_TOOLS=1   # 1 (default): the LLM planner names a prompt template
#                      #   (agents/query_agent/prompts/templates.yaml) and routes
#                      #   from it. 0: DEGRADED MODE - no model in the routing
#                      #   loop, deterministic keyword routing, structural
#                      #   questions only. Only set 0 for the fully-offline
#                      #   reviewer tour on a small local model (see ADR-0004).
# QUERY_INTERPRET=1
# QUERY_VERIFY=1
# QUERY_DETERMINISTIC_COMPOSE=1   # structural answers (count/list/breakdown) are
#                                 # templated from tool output with no LLM draft
# QUERY_MAX_TOOL_CALLS=5
# QUERY_LIST_FULL_MAX=10
# QUERY_SEARCH_K=8
# PLANNER_MAX_STEPS=3
# AGENT_SUMMARY_MIN_TURNS=6
